
set test_title "0-simple.exe: basic C Test"
set test "0-simple.exe"
set test_targ "./testing/$test"
set procs 2
exec sleep $pause_time


case "$launch" in {
    { "jsrun" } { 
        set pre_args ""
        set post_args ""
        set pre_procs "-p2"
        set post_procs ""
    }
    { "prun" | "srun" } { 
        set pre_args "-p$pool"
        set post_args ""
        set pre_procs "-n$procs"
        set post_procs ""
    }
    { "flux" } {
        set pre_args "run -n"
        set pre_procs $procs
        set post_args ""
        set post_procs ""
    }
    { "mpirun" } { 
        set pre_args "-np"
        set pre_procs $procs
        set post_args ""
        set post_procs ""
    }
    { "poe" } { 
        set env(MP_PROCS) $procs
        set env(MP_NODES) 1
        set env(MP_RMPOOL) $rmpool
        set pre_args ""
        set post_args ""
        set pre_procs ""
        set post_procs ""
    }
}

set timeout 30

set command "$launch $pre_args $pre_procs $test_targ $post_args $post_procs"
send_user "${command} \n"
spawn -noecho {*}${command}

expect { 
   "Collector found no records to merge."   { 
     pass "$test passed" 
#     close
#     wait
     } 
   timeout { fail "$test timed out\n\n" }
   eof     { fail "$test failed\n\n" }

   }

send_user "$expect_out(buffer)\n\n"
